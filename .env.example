# Admin password for wallet access
ADMIN_PASSWORD=PLACEHOLDER_CHANGE_ME

# Session secret
SESSION_SECRET=PLACEHOLDER_CHANGE_ME

# Infura/Alchemy API key for Ethereum RPC
# Get free at: https://infura.io or https://alchemy.com
ETH_RPC_URL=https://mainnet.infura.io/v3/PLACEHOLDER_YOUR_INFURA_KEY

# BNB Chain RPC (public, no key needed)
BNB_RPC_URL=https://bsc-dataseed.binance.org

# Polygon RPC (public)
POLYGON_RPC_URL=https://polygon-rpc.com

# Arbitrum RPC (public)
ARBITRUM_RPC_URL=https://arb1.g.alchemy.com/public

# Optimism RPC (public)
OPTIMISM_RPC_URL=https://mainnet.optimism.io

PORT=4000
